<Project Sdk="Microsoft.NET.Sdk">
  <!-- A plain console test runner (no NuGet packages), so it also runs where NuGet is unreachable.
       Run: dotnet run (from windows/Reroll.Core.Tests). Exit code 0 means all passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reroll.Core\Reroll.Core.csproj" />
  </ItemGroup>
</Project>
