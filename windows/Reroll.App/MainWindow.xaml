<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Reroll.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Reroll.App"
    Title="Reroll">

    <Grid x:Name="Root" Background="{StaticResource PaperBrush}" Padding="40,0,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: the mark, then where Reroll is looking -->
        <Grid Grid.Row="0" Padding="0,22,0,14" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <local:Die Face="2" Size="24" />
                <TextBlock Text="reroll" FontFamily="{StaticResource Display}" FontSize="20" CharacterSpacing="-40" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="FolderText" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           MaxWidth="520" VerticalAlignment="Center" />
                <Button x:Name="ChangeFolderButton" Content="Change folder" Style="{StaticResource LinkButton}" Click="ChangeFolder_Click" />
            </StackPanel>
        </Grid>

        <!-- Main: what to do now (left), your plays (right) -->
        <Grid Grid.Row="1" ColumnSpacing="56" Padding="0,36,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="5*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left column: one of four panels is visible -->
            <Grid Grid.Column="0">
                <!-- No Medal folder found -->
                <StackPanel x:Name="SetupPanel" Spacing="18" Visibility="Collapsed">
                    <TextBlock Text="Where does Medal save your clips?" FontFamily="{StaticResource Display}" FontSize="44"
                               CharacterSpacing="-50" LineHeight="46" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource BodyText}" MaxWidth="520"
                               Text="Reroll couldn't find Medal's clip folder. In Medal it's under Settings, PC Storage, Capture Folder Location. Pick that folder and Reroll watches it from now on." />
                    <Button Content="Choose folder" Style="{StaticResource PrimaryButton}" Click="ChangeFolder_Click" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Ready to make a video -->
                <StackPanel x:Name="ReadyPanel" Spacing="18">
                    <TextBlock x:Name="Headline" Text="Looking for your plays." FontFamily="{StaticResource Display}" FontSize="56"
                               CharacterSpacing="-55" LineHeight="56" TextWrapping="Wrap" />
                    <TextBlock x:Name="Subline" Style="{StaticResource BodyText}" MaxWidth="500"
                               Text="Reroll puts your recent plays into one vertical video, best play last. You add the song when you post." />
                    <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,10,0,0">
                        <Button x:Name="MakeButton" Style="{StaticResource PrimaryButton}" Click="Make_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="18" Height="18" Background="Transparent">
                                    <local:Die x:Name="MakeDie" Face="6" Size="18" />
                                </Grid>
                                <TextBlock Text="Make my video" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="MakeHint" Style="{StaticResource MutedText}" VerticalAlignment="Center" MaxWidth="260" />
                    </StackPanel>
                </StackPanel>

                <!-- Working -->
                <StackPanel x:Name="WorkingPanel" Spacing="18" Visibility="Collapsed">
                    <TextBlock x:Name="WorkingTitle" Text="Making your video." FontFamily="{StaticResource Display}" FontSize="56"
                               CharacterSpacing="-55" LineHeight="56" TextWrapping="Wrap" />
                    <TextBlock x:Name="StageText" Style="{StaticResource BodyText}" Text="Looking for your plays" />
                    <Grid Height="4" MaxWidth="520" HorizontalAlignment="Stretch" Background="{StaticResource HairlineBrush}">
                        <Rectangle x:Name="ProgressFill" Fill="{StaticResource InkBrush}" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <TextBlock x:Name="PercentText" Style="{StaticResource MutedText}" Text="0%" />
                        <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource LinkButton}" Click="Cancel_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" MaxWidth="500"
                               Text="This runs on your PC. You can keep playing; Reroll works in the background." />
                </StackPanel>

                <!-- Done -->
                <Grid x:Name="DonePanel" Visibility="Collapsed" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="248" Height="441" Background="{StaticResource InkBrush}" VerticalAlignment="Top">
                        <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" Stretch="Uniform" AutoPlay="False" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="16">
                        <TextBlock Text="Your video is ready." FontFamily="{StaticResource Display}" FontSize="44"
                                   CharacterSpacing="-50" LineHeight="46" TextWrapping="Wrap" />
                        <TextBlock x:Name="DoneDetail" Style="{StaticResource BodyText}" />
                        <Button Style="{StaticResource PrimaryButton}" Click="ShowInFolder_Click" Margin="0,8,0,0" Content="Show in folder" />
                        <Button Content="Back to my plays" Style="{StaticResource LinkButton}" Click="Back_Click" />
                    </StackPanel>
                </Grid>

                <!-- A problem, shown under whichever panel is up -->
                <Border x:Name="ErrorBox" VerticalAlignment="Bottom" Visibility="Collapsed" Padding="14,12"
                        BorderBrush="{StaticResource InkBrush}" BorderThickness="2" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Something went wrong" Style="{StaticResource Label}" />
                        <TextBlock x:Name="ErrorText" Style="{StaticResource MutedText}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right column: plays found so far, newest first -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                    <TextBlock Text="Your plays" Style="{StaticResource Label}" />
                    <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="PlayList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PlayRow">
                                <Grid Padding="0,13" ColumnSpacing="14" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                                      Opacity="{x:Bind Opacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <local:Die Face="{x:Bind Face}" Size="22" Outline="True" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource Bold}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Badge}" FontFamily="{StaticResource Bold}" FontSize="12"
                                               VerticalAlignment="Center" CharacterSpacing="60" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyPlays" Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,14,0,0" Visibility="Collapsed"
                           Text="No plays yet. Clip a fight with Medal and it shows up here." />
            </Grid>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Margin="0,18,0,0"
                   Text="Runs on your PC; clips are never uploaded. Not affiliated with Medal or Riot Games." />
    </Grid>
</Window>
