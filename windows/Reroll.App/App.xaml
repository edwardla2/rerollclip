<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Reroll.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Same system as the website: white, black, one grey, hairlines, Schibsted Grotesk. -->
            <Color x:Key="Paper">#FFFFFFFF</Color>
            <Color x:Key="Ink">#FF000000</Color>
            <Color x:Key="Muted">#FF6E6E6E</Color>
            <Color x:Key="Hairline">#FFDADADA</Color>
            <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}" />
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
            <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}" />

            <FontFamily x:Key="Body">ms-appx:///Assets/Fonts/SchibstedGrotesk-400.ttf#Schibsted Grotesk</FontFamily>
            <FontFamily x:Key="Medium">ms-appx:///Assets/Fonts/SchibstedGrotesk-500.ttf#Schibsted Grotesk Medium</FontFamily>
            <FontFamily x:Key="Bold">ms-appx:///Assets/Fonts/SchibstedGrotesk-700.ttf#Schibsted Grotesk</FontFamily>
            <FontFamily x:Key="Display">ms-appx:///Assets/Fonts/SchibstedGrotesk-800.ttf#Schibsted Grotesk ExtraBold</FontFamily>

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Bold}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Body}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>
            <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="19" />
            </Style>

            <!-- Square black button, white text; inverts on hover like the site's. -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource InkBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="26,14" />
                <Setter Property="FontFamily" Value="{StaticResource Bold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource PaperBrush}" />
                                                <Setter Target="Content.Foreground" Value="{StaticResource InkBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource HairlineBrush}" />
                                                <Setter Target="Content.Foreground" Value="{StaticResource InkBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Text-only button for secondary actions. -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource Bold}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter x:Name="Content" Foreground="{TemplateBinding Foreground}" />
                                <Rectangle x:Name="Underline" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-2"
                                           Fill="{StaticResource InkBrush}" Opacity="0" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Underline.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
